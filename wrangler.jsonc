{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // نام ورکر شما در کلودفلر. هرچه می‌خواهید بگذارید.
  // آدرس نهایی: https://<name>.<subdomain>.workers.dev
  "name": "web-app",

  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],

  // دیتابیس D1. اسم بایندینگ حتماً باید DB بماند.
  // database_id را از خروجی «wrangler d1 create nova-db» بردارید.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nova-db",
      "database_id": "PUT-YOUR-D1-DATABASE-ID-HERE"
    }
  ],

  // فضای KV. اسم بایندینگ حتماً باید KV بماند.
  // id را از خروجی «wrangler kv namespace create KV» بردارید.
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "PUT-YOUR-KV-NAMESPACE-ID-HERE"
    }
  ],

  "workers_dev": true,
  "preview_urls": true,

  // کران تریگر برای کارهای نگهداری پس‌زمینه.
  // فقط وقتی کار می‌کند که متغیر ENABLE_CRON=1 را هم ست کنید.
  "triggers": {
    "crons": ["17 4 * * *"]
  },

  // لاگ‌ها فقط داخل حساب کلودفلر خودتان می‌مانند و جایی ارسال نمی‌شوند.
  // اگر اصلاً لاگ نمی‌خواهید، enabled را false کنید.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }

  // متغیرهای حساس (ADMIN، KEY، UUID، PROXYIP، NOVA_CLAIM_TOKEN و ...)
  // را اینجا ننویسید. با دستور زیر به‌صورت رمزنگاری‌شده ست کنید:
  //   wrangler secret put ADMIN
}
