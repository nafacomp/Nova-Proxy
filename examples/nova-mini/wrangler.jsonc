{
  "name": "my-tunnel",
  "main": "src/worker.js",

  // این ورکر هیچ ماژول node: استفاده نمی‌کند، پس به فلگ nodejs_compat
  // نیازی ندارد. (تست شده: بدون فلگ، پنل و لینک اشتراک کامل کار می‌کنند.)
  // اگر بعداً کدی اضافه کردید که node: لازم داشت، آن‌وقت اضافه‌اش کنید.
  "compatibility_date": "2026-07-30",

  // فضای KV برای ذخیرهٔ کاربران، تنظیمات و رمز ادمین.
  // شناسه را با «npm run setup» یا دستی پر کنید:
  //   npx wrangler kv namespace create KV
  "kv_namespaces": [
    { "binding": "KV", "id": "PUT-YOUR-KV-NAMESPACE-ID-HERE" }
  ],

  "workers_dev": true,

  "vars": {
    // سقف تعداد کاربر. برای استفادهٔ شخصی کم نگهش دارید.
    "MAX_USERS": "5"
  }

  // رمزها را اینجا ننویسید. با دستور زیر ست کنید:
  //   npx wrangler secret put CLAIM_TOKEN
  //   npx wrangler secret put PROXYIP
}
